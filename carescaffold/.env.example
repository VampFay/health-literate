# ── CareScaffold environment variables ──
# Copy to .env and populate. NEVER commit a real .env.

# ── LLM / Embedding API keys (required from Phase 2 onward) ──
ANTHROPIC_API_KEY=
VOYAGEAI_API_KEY=

# ── Database ──
# Spec §2 calls for PostgreSQL 16+ with pgvector.
# Demo swap path: SQLite + sqlite-vec (see README §Database).
DATABASE_URL=sqlite+aiosqlite:///./carescaffold.db

# ── Minimal demo auth (single API key) ──
# This is a portfolio demo, NOT multi-tenant SaaS — see spec §3 note on /core auth.
CARESCAFFOLD_API_KEY=

# ── Audit log integrity ──
# Salt for span_hash; rotate if audit log integrity is suspected compromised.
AUDIT_LOG_HASH_SALT=

# ── Config ──
MODEL_REGISTRY_PATH=./config/model_registry.yaml
